{
  "name": "@kas-stock/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:check": "tsx --env-file=../../.env src/scripts/check-db.ts",
    "db:validate": "tsx --env-file=../../.env src/scripts/validate-db.ts",
    "db:validate-auth": "tsx --env-file=../../.env src/scripts/validate-auth.ts"
  },
  "prisma": {
    "seed": "tsx --env-file=../../.env prisma/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@prisma/client": "^6.5.0",
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^3.0.2",
    "hono": "^4.7.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@kas-stock/config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
