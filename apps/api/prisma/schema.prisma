generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

/// Application users (custom auth password hash for Phase 03).
/// RLS uses auth.uid() so this table can later align with Supabase Auth user ids.
model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  categories   Category[]
  transactions Transaction[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stockItems StockItem[]

  @@unique([userId, name], map: "categories_user_id_name_key")
  @@index([userId], map: "categories_user_id_idx")
  @@map("categories")
}

model StockItem {
  id           String   @id @default(uuid()) @db.Uuid
  categoryId   String   @map("category_id") @db.Uuid
  name         String   @db.VarChar(255)
  quantity     Int      @default(0)
  unit         String   @db.VarChar(50)
  price        Decimal  @default(0) @db.Decimal(14, 2)
  minimumStock Int      @default(0) @map("minimum_stock")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([categoryId], map: "stock_items_category_id_idx")
  @@map("stock_items")
}

model Transaction {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  type            TransactionType
  amount          Decimal         @db.Decimal(14, 2)
  description     String?         @db.Text
  transactionDate DateTime        @map("transaction_date") @db.Date
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId], map: "transactions_user_id_idx")
  @@index([transactionDate], map: "transactions_transaction_date_idx")
  @@index([type], map: "transactions_type_idx")
  @@map("transactions")
}
