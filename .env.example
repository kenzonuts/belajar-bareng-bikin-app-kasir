# =============================================================================
# Kas + Stock — environment template
# Copy to `.env` and fill with your Supabase project values.
# NEVER commit the real `.env` file.
# =============================================================================

# --- Supabase (required) ----------------------------------------------------
# Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role is SERVER-ONLY. Never expose to Vite/frontend/client bundles.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Project Settings → Database → Connection string (Session pooler, port 5432)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Backend ----------------------------------------------------------------
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# --- Frontend (public only) -------------------------------------------------
API_URL=http://localhost:3001
VITE_API_URL=http://localhost:3001
# Public Supabase values only — never put SERVICE_ROLE_KEY here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
